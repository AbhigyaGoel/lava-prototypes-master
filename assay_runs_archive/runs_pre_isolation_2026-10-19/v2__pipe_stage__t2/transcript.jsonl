eg  [7:0] out_data\n);\n    reg       skid_valid;\n    reg [7:0] skid_data;\n\n    assign in_ready = !skid_valid || out_ready;\n\n    wire push = in_valid && in_ready;\n    wire pop  = out_valid && out_ready;\n\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            out_valid  <= 1'b0;\n            out_data   <= 8'd0;\n            skid_valid <= 1'b0;\n            skid_data  <= 8'd0;\n        end else if (!out_valid || pop) begin\n            if (skid_valid) begin\n                out_valid  <= 1'b1;\n                out_data   <= skid_data;\n            end else begin\n                out_valid <= push;\n                if (push)\n                    out_data <= in_data;\n            end\n        end else if (push) begin\n            skid_valid <= 1'b1;\n            skid_data  <= in_data;\n        end\n    end\nendmodule\n","numLines":40,"startLine":1,"totalLines":40}}}
