t        repeat (3) begin\n44\t            @(posedge clk); #1; expect_out(1, 8'h5C);\n45\t        end\n46\t        @(negedge clk); out_ready = 1;\n47\t        @(posedge clk); #1; expect_out(0, 8'h00);\n48\t        if (errors == 0) $display(\"TEST PASSED\");\n49\t        else $display(\"TEST FAILED: %0d errors\", errors);\n50\t        $finish;\n51\t    end\n52\tendmodule\n53\t"}]},"parent_tool_use_id":null,"session_id":"e9dbcf08-59ac-45de-818a-263d2256c230","uuid":"3de39cd9-c6fa-4fca-aa6e-e1af254e06c6","timestamp":"2026-10-19T23:52:10.699Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\abhig\\Documents\\New folder\\assay\\runs\\v1__pipe_stage__t3\\workspace\\tb\\tb_visible.v","content":"`timescale 1ns/1ps\nmodule tb;\n    reg clk = 0, rst_n = 1;\n    reg in_valid = 0, out_ready = 0;\n    reg [7:0] in_data = 0;\n    wire in_ready, out_valid;\n    wire [7:0] out_data;\n    integer errors = 0, i;\n\n    pipe_stage dut (.clk(clk), .rst_n(rst_n), .in_valid(in_valid), .in_ready(in_ready),\n                    .in_data(in_data), .out_valid(out_valid), .out_ready(out_ready),\n                    .out_data(out_data));\n    always #5 clk = ~clk;\n    initial begin #100000 $display(\"ERROR: watchdog timeout\"); $finish; end\n\n    task expect_out(input v, input [7:0] d);\n        if (out_valid !== v || (v && out_data !== d)) begin\n            $display(\"FAIL: t=%0t out_valid=%b out_data=%h expected valid=%b data=%h\",\n                     $time, out_valid, out_data, v, d);\n            errors = errors + 1;\n        end\n    endtask\n\n    initial begin\n        #1 rst_n = 0;\n        #11 rst_n = 1;\n        if (out_valid !== 1'b0 || in_ready !== 1'b1) begin\n            $display(\"FAIL: bad state after reset\"); errors = errors + 1;\n        end\n        // streaming with the sink always ready\n        out_ready = 1;\n        for (i = 0; i < 8; i = i + 1) begin\n            @(negedge clk); in_valid = 1; in_data = 8'hA0 + i;\n            if (in_ready !== 1'b1) begin $display(\"FAIL: in_ready low while streaming\"); errors = errors + 1; end\n            @(posedge clk); #1;\n            expect_out(1, 8'hA0 + i);\n        end\n        @(negedge clk); in_valid = 0;\n        @(posedge clk); #1; expect_out(0, 8'h00);\n        // single word held while the sink stalls\n        @(negedge clk); out_ready = 0; in_valid = 1; in_data = 8'h5C;\n        @(negedge clk); in_valid = 0;\n        repeat (3) begin\n            @(posedge clk); #1; expect_out(1, 8'h5C);\n        end\n        @(negedge clk); out_ready = 1;\n        @(posedge clk); #1; expect_out(0, 8'h00);\n        if (errors == 0) $display(\"TEST PASSED\");\n        else $display(\"TEST FAILED: %0d errors\", errors);\n        $finish;\n    end\nendmodule\n","numLines":53,"startLine":1,"totalLines":53}}}
