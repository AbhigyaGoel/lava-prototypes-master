# Leave everything blank to run in mock mode (no accounts needed).
# UNIFI_MODE=mock|live   (default: live when LITHIC_API_KEY and PLAID_CLIENT_ID are set)

# --- Database ---
# Blank = PGlite on disk at .data/pglite. Set to your Supabase connection string to use Postgres.
DATABASE_URL=

# --- App ---
APP_URL=http://localhost:3000
CLUB_NAME=NSBE at USC
TREASURER_NAME=Devin
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Vercel Cron sends this as a bearer token
CRON_SECRET=

# --- Plaid (sandbox) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Lithic (sandbox) ---
LITHIC_API_KEY=
LITHIC_ENV=sandbox
# From GET /v1/auth_stream/secret after enrolling /api/lithic/asa as your ASA endpoint
LITHIC_ASA_SECRET=
# From the Lithic dashboard webhook settings for /api/lithic/events
LITHIC_WEBHOOK_SECRET=

# --- Mock mode only ---
MOCK_BALANCE_CENTS=124000
